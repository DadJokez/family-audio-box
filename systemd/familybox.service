[Unit]
Description=FamilyBox local-first audio player
After=local-fs.target sound.target
Wants=avahi-daemon.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=familybox
Group=familybox
SupplementaryGroups=audio gpio spi
WorkingDirectory=/opt/familybox
EnvironmentFile=-/etc/familybox/familybox.env
Environment=PYTHONUNBUFFERED=1
RuntimeDirectory=familybox
RuntimeDirectoryMode=0750
ExecStart=/opt/familybox/.venv/bin/python -m familybox.main
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=mixed
SyslogIdentifier=familybox
StandardOutput=journal
StandardError=journal
UMask=0027

# The player needs the local media/state tree and its runtime mpv socket only.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/familybox
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
