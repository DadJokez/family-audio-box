# Local development defaults. Copy to .env only if your launcher loads it.
FAMILYBOX_ROOT=./.familybox
FAMILYBOX_HARDWARE=fake
FAMILYBOX_AUDIO=fake
FAMILYBOX_DEVICE_NAME="FamilyBox Development"

# Leave FAMILYBOX_DEVICE_ID unset to derive a stable UUID from the hostname.
# FAMILYBOX_DEVICE_ID=00000000-0000-0000-0000-000000000000
# FAMILYBOX_HOSTNAME=familybox-development

# Derived from FAMILYBOX_ROOT when omitted.
# FAMILYBOX_MEDIA_DIR=./.familybox/media
# FAMILYBOX_DATA_DIR=./.familybox/data
# FAMILYBOX_CACHE_DIR=./.familybox/cache
# FAMILYBOX_LOGS_DIR=./.familybox/logs
# FAMILYBOX_DATABASE=./.familybox/data/familybox.db

FAMILYBOX_MPV_BINARY=mpv
FAMILYBOX_MPV_SOCKET=./.familybox/cache/mpv.sock
FAMILYBOX_WEB_HOST=127.0.0.1
FAMILYBOX_WEB_PORT=8080

FAMILYBOX_PROGRESS_SAVE_INTERVAL=60
FAMILYBOX_NFC_POLL_INTERVAL=0.15
FAMILYBOX_NFC_PRESENT_SAMPLES=2
FAMILYBOX_NFC_REMOVED_SAMPLES=3

FAMILYBOX_LOG_LEVEL=INFO
FAMILYBOX_JSON_LOGS=false
FAMILYBOX_DEV_ENDPOINTS=true
